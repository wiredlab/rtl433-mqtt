# Compatibility copy of config/rtl433-mqtt.env.
# The documented configuration source is config/rtl433-mqtt.env, and the
# installer preserves the deployed file at /etc/rtl433-mqtt/rtl433-mqtt.env.

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=0
MQTT_TLS_CA_CERT=
MQTT_TLS_CERT=
MQTT_TLS_KEY=

MQTT_TOPIC_PREFIX=rtl433
MQTT_BASE_TOPIC=
MQTT_RETAIN=0
MQTT_ENABLE_AVAILABILITY=1
MQTT_ENABLE_EVENTS=1
MQTT_ENABLE_STATES=1
MQTT_ENABLE_DEVICES=1

RECEIVER_FREQ=433.92M
RECEIVER_ID=
RTL433_OPTS=

RTL433_EVENT_LOG=/var/log/rtl433-mqtt/rtl433-events.jsonl
RTL433_LOG_JSONL=1
